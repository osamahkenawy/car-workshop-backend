# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database (MySQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=car_workshop

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
MECHANIC_ACCESS_TTL_SHORT=12h
MECHANIC_REFRESH_TTL_DAYS=30
API_KEY_PREFIX=cw_

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@car-workshop.local
SMTP_FROM_NAME=Car Workshop Platform

# ── SMS (Twilio-compatible; leave SMS_PROVIDER blank to log-only stub) ──
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@car-workshop.local

# ── Firebase (FCM push for the mechanic mobile app) ─────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ── AWS S3 (file uploads; omit to fall back to local ./uploads storage) ─
AWS_S3_BUCKET=
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Stripe (subscription billing) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Routing (OSRM, used for vehicle-pickup distance estimates) ─────────
OSRM_URL=https://router.project-osrm.org

# ── Cron / scheduled jobs ────────────────────────────────────────────────
CRON_TZ=Asia/Dubai
PAST_DUE_SUSPEND_AFTER_DAYS=7

# ── Super admin digest ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_DIGEST_SKIP_EMPTY=true

# ── Financial defaults (platform-wide fallbacks; can be overridden per workshop) ─
VAT_ENABLED=true
VAT_RATE=5.0
APPLY_VAT_ON_SERVICE_FEE=true
APPLY_VAT_ON_CASH=false
COMMISSION_PERCENT=0
PAYMENT_GATEWAY_FEE_PCT=0
MECHANIC_EARNING_TYPE=flat
MECHANIC_EARNING_RATE=0
MECHANIC_EARNING_CASH_PCT=0

# Never enable in production: when true the forgot-password response echoes
# the OTP back to the caller.
LOG_OTP_SECRET=false

# Slug of the workshop a bare /survey link belongs to. Set this and the public
# survey / QR link can be shared as https://<host>/survey with no query string.
# Leave blank when the deployment hosts a single workshop.
PUBLIC_SURVEY_WORKSHOP=

# Origins allowed to submit the public website enquiry form (comma-separated)
PUBLIC_WEB_ORIGINS=https://pioneeruae.com,https://www.pioneeruae.com
